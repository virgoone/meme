{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meme",
  "workers_dev": true,
  "routes": [{ "pattern": "blog.douni.one/api/page-views*", "zone_name": "douni.one" }],
  "main": "apps/server/src/cloudflare/worker.ts",
  "compatibility_date": "2026-06-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meme-prod",
      "database_id": "bbc33e62-7322-4513-8188-87699d95cd46",
      "migrations_dir": "packages/db/drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MEME_KV",
      "id": "bd0e5bd95ea3410eb3c26910bd7ac799",
      "preview_id": "0a9478ddb0a149408a11fc75159acb35"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "meme-assets",
      "preview_bucket_name": "meme-assets-preview"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "SITE_URL": "https://blog.douni.one",
    "TRUSTED_ORIGINS": "https://blog.douni.one,https://meme-zeta.vercel.app,https://meme-larks-projects-aafa7a73.vercel.app,https://meme-git-main-larks-projects-aafa7a73.vercel.app,https://meme.moss-dev.workers.dev"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
