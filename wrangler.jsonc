{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meme",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "blog.douni.one",
      "custom_domain": true,
      "zone_name": "douni.one"
    }
  ],
  "main": "apps/server/src/cloudflare/worker.ts",
  "compatibility_date": "2026-06-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "MEME_KV",
      "id": "bd0e5bd95ea3410eb3c26910bd7ac799",
      "preview_id": "0a9478ddb0a149408a11fc75159acb35"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "meme-assets",
      "preview_bucket_name": "meme-assets-preview"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "SITE_URL": "https://blog.douni.one",
    "TRUSTED_ORIGINS": "https://blog.douni.one,https://meme-zeta.vercel.app,https://meme-larks-projects-aafa7a73.vercel.app,https://meme-git-main-larks-projects-aafa7a73.vercel.app,https://meme.moss-dev.workers.dev",
    "DATABASE_PROVIDER": "libsql",
    "TURSO_DB_URL": "libsql://meme-moss.aws-ap-northeast-1.turso.io"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
