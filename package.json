{
  "name": "meme",
  "version": "1.0.0",
  "description": "Cloudflare blog — TanStack Start (apps/web) + Workers/D1 API (apps/server)",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:web",
    "build:server": "bun --cwd apps/server build",
    "build:web": "bun --cwd apps/web build",
    "cf:d1:migrate:prod": "bun --cwd apps/server db:migrate:prod",
    "cf:deploy": "bun --cwd apps/server deploy",
    "check-types": "bun run check-types:web && bun run check-types:server && bun run check-types:editor",
    "check-types:editor": "bun run --cwd packages/editor check-types",
    "check-types:server": "bun run --cwd apps/server check-types",
    "check-types:web": "bun run --cwd apps/web check-types",
    "dev": "bun run dev:web",
    "dev:server": "bun --cwd apps/server dev",
    "dev:web": "bun --cwd apps/web dev",
    "start": "bun --cwd apps/web dev",
    "lint": "biome lint .",
    "lint:migration": "biome lint apps packages scripts",
    "kv:export-reactions": "bun scripts/export-upstash-reactions-to-kv-bulk.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3"
  }
}
