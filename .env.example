# =========================================================================
# Cloudflare Worker (apps/server) — set in a gitignored `.dev.vars` at the
# repo root for local dev, and as Wrangler secrets/vars for production.
# =========================================================================

APP_ENV="development"
SITE_URL="http://127.0.0.1:3000"
TRUSTED_ORIGINS="http://127.0.0.1:3000"

# Better Auth (passwordless email OTP). Generate the secret with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Defaults to SITE_URL when empty.
BETTER_AUTH_URL=""
# Comma-separated emails granted the `admin` role on sign-up.
ADMIN_EMAILS=""

# Email delivery (login codes, notifications) via Resend.
RESEND_API_KEY=""
EMAIL_FROM="Meme <onboarding@resend.dev>"

# Object storage — Cloudflare R2 via the S3-compatible API (media uploads).
S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="meme-assets"
S3_URL_BASE="/api/media/object"

# Optional integrations.
LINK_PREVIEW_API_BASE_URL=""

# =========================================================================
# Web app (apps/web) — set in apps/web/.env.local (Vite, VITE_ prefix).
# =========================================================================

# API base. Leave empty for same-origin (the dev server proxies /api).
# VITE_API_BASE_URL=""
# Override the remote editor widget bundle (defaults to the pinned jsDelivr URL).
# VITE_EDITOR_WIDGET_URL=""
# Optional public object URL base for uploaded media.
# VITE_UPLOAD_URL_BASE=""

# Vercel domain gateway. Runtime secrets remain on the Cloudflare Worker.
# Required in Vercel Production and Preview; no database import runs at build.
CLOUDFLARE_ORIGIN="https://meme.moss-dev.workers.dev"
